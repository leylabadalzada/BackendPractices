@model List<BlogGetVM>

<div class="container">
    <a class="btn btn-primary" asp-action="Create">Create</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Title</th>
                <th scope="col">Text</th>
                <th scope="col">Image</th>
                <th scope="col">Category</th>
                <th scope="col">Created at</th>
                <th scope="col">Updated at</th>
                <th scope="col">Buttons</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@item.Id</th>
                    <td>@item.Title</td>
                    <td>@item.Text</td>
                    <td><img style="width:100px;height:100px;object-fit:cover;" class="img-thumbnail" src="~/images/blog/@item.Image" /></td>
                    <td>@item.CategoryName</td>
                    <td>@item.CreatedAt</td>
                    <td>@item.UpdatedAt</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <form asp-action="remove" asp-route-id="@item.Id" class="m-0">
                                <button type="submit" class="btn btn-sm p-0 border-0">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </form>

                            <a asp-action="update" asp-route-id="@item.Id">
                                <i class="fa-solid fa-edit text-warning"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn btn-default" asp-controller="dashboard" asp-action="index">Go dashboard</a>
</div>
