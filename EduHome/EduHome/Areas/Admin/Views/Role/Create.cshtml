@model RoleCreateVM

<div class="container">
    <form asp-area="admin" asp-action="create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
       
        <div class="form-group">
            <label asp-for="Name">Title</label>
            <input class="form-control" asp-for="Name" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Description">Text</label>
            <textarea class="form-control" asp-for="Description" aria-describedby="emailHelp"></textarea>
        </div>
        <a class="btn btn-secondary-outline" asp-action="index">Go back</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>
