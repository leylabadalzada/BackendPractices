@model List<ProductGetVM>

<div class="container">
    <a class="btn btn-primary" asp-controller="Product" asp-action="Create">Create</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Client</th>
                <th scope="col">Link</th>
                <th scope="col">Price</th>
                <th scope="col">Date</th>
                <th scope="col">Category</th>
                <th scope="col">CreatedAt</th>
                <th scope="col">UpdatedAt</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@item.Id</th>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Client</td>
                    <td>@item.URL</td>
                    <td>@item.Price</td>
                    <td>@item.Date</td>
                    <td>@item.CategoryId</td>
                    <td>@item.CreatedAt</td>
                    <td>@item.UpdatedAt</td>
                    <td>
                        <form asp-action="Remove" asp-route-id="@item.Id">
                            <button class="btn btn-danger">Remove</button>
                        </form>
                        <a asp-action="update" asp-route-id="@item.Id" class="btn btn-warning">Update</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>