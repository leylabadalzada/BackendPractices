@model SliderCreateVM

<div class="container">
    <form asp-area="admin" asp-action="create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input class="form-control" asp-for="Title" aria-describedby="emailHelp" >
        </div>
        <div class="form-group">
            <label asp-for="Text">Text</label>
            <input class="form-control" asp-for="Text" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Image">Title</label>
            <input class="form-control" asp-for="Image" type="file" aria-describedby="emailHelp">
        </div>
        <a class="btn btn-secondary-outline" asp-action="index">Go back</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>
