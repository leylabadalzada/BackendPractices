@model ResetPasswordVM

<!-- Banner Area Start -->
<div class="banner-area-wrapper">
    <div class="banner-area text-center">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="banner-content-wrapper">
                        <div class="banner-content">
                            <h2>Reset password</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner Area End -->
<!-- Login start -->
<div class="login-area pt-150 pb-150">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3 text-center">
                <div class="login">
                    <div class="login-form-container">
                        <div class="login-text">
                            <h2>Reset password</h2>
                        </div>
                        <div class="login-form">
                            <form asp-action="resetpassword" method="post">
                                <input asp-for="Email" value="@ViewBag.Email" hidden>
                                <input asp-for="Token" value="@ViewBag.Token" hidden>
                                <label asp-for="Password">New Password</label>
                                <input asp-for="Password" type="password">
                                <label asp-for="ConfirmPassword">Repeat New Password</label>
                                <input asp-for="ConfirmPassword" type="password">
                                <button type="submit" class="btn btn-primary">Reset Password</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>