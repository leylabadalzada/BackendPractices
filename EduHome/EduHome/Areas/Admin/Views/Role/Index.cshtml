@model List<RoleGetVM>

<div class="container">
    <a class="btn btn-primary" asp-action="Create">Create</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Buttons</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@item.Id</th>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <form asp-action="remove" asp-route-id="@item.Id" class="m-0">
                                <button type="submit" class="btn btn-sm p-0 border-0">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn btn-default" asp-controller="dashboard" asp-action="index">Go dashboard</a>
</div>
