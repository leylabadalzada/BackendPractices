@model BlogUpdateVM

<div class="container">
    <form asp-area="teacher" asp-action="update" method="post" enctype="multipart/form-data">
        <img style="width:100px;height:100px;object-fit:cover;" class="img-thumbnail" src="~/images/blog/@Model.ImageName" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input class="form-control" asp-for="Title" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Text">Text</label>
            <textarea class="form-control" asp-for="Text" aria-describedby="emailHelp"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="Image">Image</label>
            <input class="form-control" asp-for="Image" type="file" aria-describedby="emailHelp">
        </div>
        <a class="btn btn-secondary-outline" asp-action="index">Go back</a>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>